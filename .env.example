APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Damascus

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+03:00

MEETING_PROVIDER_DEFAULT=jitsi_public
JITSI_PUBLIC_DOMAIN=meet.leaders-academy.net
# Backward-compatible alias (optional): JITSI_DOMAIN=meet.leaders-academy.net

# Embedded mode: Jitsi iframe inside the LMS page (recommended for self-hosted servers).
JITSI_EMBED_ENABLED=true
JITSI_STANDALONE_WINDOW_DOMAINS=
JITSI_PREFER_STANDALONE_WINDOW=false

# Optional JWT — enforce lecturer = only moderator. Requires YOUR Jitsi server with token auth.
# JITSI_JWT_APP_ID=
# JITSI_JWT_APP_SECRET=
# JITSI_JWT_SUB=meet.leaders-academy.net
# JITSI_JWT_AUDIENCE=jitsi
# JITSI_JWT_TTL_SECONDS=21600

LIVE_SESSION_COMMENT_POLL_SECONDS=5
LIVE_SESSION_HEARTBEAT_INTERVAL_SECONDS=12
LIVE_SESSION_HEARTBEAT_TIMEOUT_SECONDS=45

# Live video: hide long doctor-facing Jitsi tips in production (default false).
MEETING_SHOW_OPERATOR_TIPS=false
# Signed LMS redirect URLs to Jitsi (student/doctor); minutes until signature expires.
MEET_LAUNCH_URL_TTL_MINUTES=45

# Doctor local recording (embedded Jitsi)
LIVE_SESSION_AUTO_LOCAL_RECORDING=true
LIVE_SESSION_RECORDING_VIDEO_KBPS=100
LIVE_SESSION_RECORDING_AUDIO_KBPS=32
LIVE_SESSION_RECORDING_HEIGHT=480

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Use "database" (or redis) in production with Supervisor — see docs/email/supervisor-leaders-queue.conf
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=students-support@leaders-academy.net
MAIL_PASSWORD="REPLACE_WITH_REAL_MAILBOX_PASSWORD"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=students-support@leaders-academy.net
MAIL_FROM_NAME="Leaders Academy - Student Support"
MAIL_EHLO_DOMAIN=leaders-academy.net

# Institutional Email Module
MAIL_MODULE_DOMAIN=leaders-academy.net
MAIL_MODULE_DRIVER=log
MAIL_MODULE_PROVISION_ON_CREATE=true
MAIL_MODULE_WEBMAIL_URL=https://mail.leaders-academy.net
MAILSERVER_DB_HOST=127.0.0.1
MAILSERVER_DB_PORT=3306
MAILSERVER_DB_DATABASE=mailserver
MAILSERVER_DB_USERNAME=mailuser
MAILSERVER_DB_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
